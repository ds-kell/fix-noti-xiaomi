<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Declared identically by the MILLET helper so install order never matters. -->
    <permission android:name="io.github.hypernotifyfix.permission.MILLET_HELPER" android:protectionLevel="signature" />
    <uses-permission android:name="io.github.hypernotifyfix.permission.MILLET_HELPER" />
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.google.android.gms" />
        <package android:name="io.github.hypernotifyfix.millethelper" />
    </queries>
    <application android:name=".HyperNotifyApplication" android:allowBackup="false" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:label="HyperNotifyFix" android:supportsRtl="true" android:theme="@style/Theme.HyperNotifyFix">
        <provider android:name="rikka.shizuku.ShizukuProvider" android:authorities="${applicationId}.shizuku" android:enabled="true" android:exported="true" android:multiprocess="false" android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <activity android:name=".MainActivity" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter></activity>
        <receiver android:name=".BackgroundMaintenanceReceiver" android:enabled="true" android:exported="false" android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service android:name=".core.system.AurogonKeepAliveService" android:exported="false" android:stopWithTask="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Keeps the HyperOS Aurogon runtime allowlist refreshed for Google Play services while the screen is off." />
        </service>
        <receiver android:name=".core.system.AurogonAlarmReceiver" android:exported="false" />
    </application>
</manifest>
